extends SceneTree
## FEEL2 run contract: real reducer + physical InputMap events, no player/camera changes.
const ActionsType = preload("res://input/actions.gd")
const Profile = preload("res://input/profile.gd")
const Hud = preload("res://input/hud.gd")
var checks := 0
var failures := []
func check(ok: bool, label: String) -> void:
	checks += 1
	if not ok: failures.append(label); printerr("FAIL ",label)
func fresh(mode := "hold", preset := "left"):
	var a := ActionsType.new()
	check(a.configure({"version":1,"preset":preset,"options":{"run_mode":mode}}).ok,"configure %s/%s" % [preset,mode])
	a.set_source("bot")
	return a
func steady(a, digital := ["move_up"], analog := [0,0]) -> float:
	for i in 16: a.advance({"digital":digital,"analog":analog})
	return a.get_move().length()
func physical(code: Key, pressed: bool) -> void:
	var e := InputEventKey.new()
	e.physical_keycode = code; e.keycode = code; e.pressed = pressed
	e.shift_pressed = pressed and code == KEY_SHIFT
	e.alt_pressed = pressed and code == KEY_ALT
	e.ctrl_pressed = pressed and code == KEY_CTRL
	Input.parse_input_event(e); Input.flush_buffered_events()
func test_default_hold() -> void:
	var a := ActionsType.new()
	check(a.profile.options.run_mode == "hold","default run mode is hold")
	check(is_equal_approx(steady(a),0.65),"default full keyboard settles at comfortable jog cap")
	check(not a.is_pressed("walk") and not a.is_pressed("run"),"unmodified jog asserts neither precision nor run")
	check(is_equal_approx(steady(a,["move_up","run"]),1.0),"hold run reaches full movement")
	check(a.is_pressed("run") and not a.is_pressed("walk"),"new run action is semantic run intent")
	a.advance({"digital":["move_up"]})
	check(is_equal_approx(a.get_move().length(),0.65) and not a.is_pressed("run"),"releasing run returns to jog on the next tick")
	check(is_equal_approx(steady(a,["move_up","run","walk"]),0.35),"precision wins over simultaneous run")
	check(a.is_pressed("walk") and not a.is_pressed("run"),"walk ID remains precision, never renamed to run")
	a.advance({"digital":["move_up","run"]})
	check(not a.is_pressed("walk") and a.is_pressed("run"),"precision is hold-only and release restores held run")
	for i in 6: a.advance({})
	check(a.get_move() == Vector2.ZERO,"jog and run release retain six-tick stop ramp")
	a.free()
func test_modes() -> void:
	for mode in ["auto","hold","toggle"]:
		var a = fresh(mode)
		check(is_equal_approx(steady(a),1.0 if mode == "auto" else 0.65),mode+" unmodified cap")
		check(a.is_pressed("run") == (mode == "auto"),mode+" unmodified run intent")
		check(is_equal_approx(steady(a,["move_up","walk"]),0.35),mode+" old walk action always precision")
		a.advance({"digital":["move_up"]})
		check(not a.is_pressed("walk"),mode+" precision does not latch")
		a.free()
	var a = fresh("toggle")
	steady(a)
	a.advance({"digital":["move_up","run"]})
	check(a.is_pressed("run") and a.just_pressed("run"),"toggle run first rising edge")
	a.advance({"digital":["move_up","run"]})
	check(a.is_pressed("run") and not a.just_pressed("run"),"held run key does not retrigger toggle")
	a.advance({"digital":["move_up"]})
	check(a.is_pressed("run") and is_equal_approx(a.get_move().length(),1.0),"toggle run survives release")
	a.advance({"digital":["move_up","walk"]})
	check(a.is_pressed("walk") and not a.is_pressed("run") and is_equal_approx(a.get_move().length(),0.35),"precision temporarily overrides toggled run")
	a.advance({"digital":["move_up"]})
	check(a.is_pressed("run") and is_equal_approx(a.get_move().length(),1.0),"precision release restores toggled run")
	a.advance({"digital":["move_up","run"]})
	check(not a.is_pressed("run") and is_equal_approx(a.get_move().length(),0.65),"second run press toggles back to jog")
	a.free()
func test_analog() -> void:
	var a = fresh()
	check(is_equal_approx(steady(a,[],[0.95,0]),0.65),"default full pad intent has comfortable jog ceiling")
	check(is_equal_approx(steady(a,["run"],[0.95,0]),1.0),"new run action permits full pad intent")
	check(is_equal_approx(steady(a,["walk","run"],[0.95,0]),0.35),"pad precision beats run")
	steady(a,[],[0.35,0])
	var low: float = (0.35-0.18)/(0.95-0.18)
	check(is_equal_approx(a.get_move().length(),low),"low analog magnitude is capped, not scaled")
	a.advance({"analog":[0.17,0]})
	check(a.get_move() == Vector2.ZERO,"existing pad dead zone stays neutral")
	a.advance({"digital":["move_up","move_right","run"]})
	steady(a,["move_up","move_right","run"])
	check(is_equal_approx(a.get_move().length(),1.0),"run diagonals retain circular clamp")
	a.free()
func test_modal_and_restore() -> void:
	var a = fresh("toggle")
	steady(a,["move_up","run"]); a.advance({"digital":["move_up"]})
	var saved: Dictionary = a.snapshot()
	a.advance({"digital":["move_up","walk"]})
	var expected: Dictionary = a.snapshot()
	a.restore(saved); a.advance({"digital":["move_up","walk"]})
	check(a.snapshot() == expected and not a.is_pressed("run"),"snapshot restore reproduces precision override of run latch")
	a.advance({"digital":["move_up"]})
	check(a.is_pressed("run"),"restored run latch survives precision release")
	a.set_context("pause")
	check(not a.is_pressed("run"),"modal boundary clears run intent immediately")
	a.advance({})
	check(not a.just_pressed("run") and not a.is_pressed("run"),"pause does not synthesize run settings press")
	a.advance({"digital":["run","walk","move_up","dodge","focus"]})
	check(a.just_pressed("run") and a.just_pressed("walk"),"modal run and precision expose their independent physical settings edges")
	check(a.get_move() == Vector2.ZERO and not a.is_pressed("focus") and not a.is_pressed("dodge"),"run cannot bypass modal gameplay suppression")
	a.set_context("gameplay")
	a.advance({"digital":["move_up","run"]})
	check(a.get_move() == Vector2.ZERO and not a.is_pressed("run"),"modal-held movement is blocked and run press does not seed a toggle")
	a.advance({}); steady(a)
	check(is_equal_approx(a.get_move().length(),0.65),"neutral after modal resumes jog, not stale toggled run")
	a.advance({"digital":["move_up","run"]})
	check(a.is_pressed("run"),"fresh run press works after modal")
	a.set_source("bot"); steady(a)
	check(not a.is_pressed("run") and is_equal_approx(a.get_move().length(),0.65),"provider reset clears run latch")
	a.free()
func test_profiles_and_physical_keys() -> void:
	for preset in ["left","right"]:
		var a = fresh("hold",preset)
		a.set_source("live")
		check(a.profile.bindings.get("run",[]) == [{"key":KEY_SHIFT}],preset+" Shift binds new run action")
		check(a.profile.bindings.walk == [{"key":KEY_ALT}],preset+" Alt binds old precision action")
		check(a.binding_glyph("run") == "Sh" and a.binding_glyph("walk") == "Alt","%s run and precision glyphs match bindings (run=%s walk=%s)" % [preset,a.binding_glyph("run"),a.binding_glyph("walk")])
		var direction: Key = KEY_W if preset == "left" else KEY_UP
		physical(direction,true)
		for i in 16: a.advance(a.sample_live())
		check(is_equal_approx(a.get_move().length(),0.65),preset+" physical movement jogs without modifier")
		physical(KEY_SHIFT,true); a.advance(a.sample_live())
		check(a.is_pressed("run") and is_equal_approx(a.get_move().length(),1.0),preset+" physical Shift runs through InputMap")
		physical(KEY_ALT,true); a.advance(a.sample_live())
		check(a.is_pressed("walk") and not a.is_pressed("run") and not a.is_pressed("dodge"),preset+" physical Alt precision is not right-preset dodge")
		physical(KEY_ALT,false); physical(KEY_SHIFT,false); physical(direction,false)
		for i in 6: a.advance(a.sample_live())
		physical(KEY_CTRL,true); a.advance(a.sample_live())
		check(not a.is_pressed("walk") and not a.is_pressed("run") and not a.is_pressed("focus"),preset+" Ctrl is neither precision nor game focus")
		physical(KEY_CTRL,false); a.advance(a.sample_live())
		check(a.get_move() == Vector2.ZERO,preset+" physical modifier releases leave no movement")
		a.free()
func test_remap_and_hud() -> void:
	var a = fresh()
	check(a.configure({"version":1,"bindings":{"run":[{"key":KEY_G}],"walk":[{"key":KEY_N}]}}).ok,"run and old precision bindings remap independently")
	check(a.binding_glyph("run") == "G" and a.binding_glyph("walk") == "N","remap updates both glyphs")
	check(not a.configure({"version":1,"bindings":{"run":[{"key":KEY_ALT}]}}).ok,"run cannot steal precision key")
	check(a.binding_glyph("run") == "Sh" and a.binding_glyph("walk") == "Alt","bad run remap falls back atomically")
	check(not a.configure({"version":1,"tuning":{"jog_modifier_cap":0.5,"walk_modifier_cap":0.6}}).ok,"jog ceiling cannot be below precision ceiling")
	check(a.configure({"version":1,"tuning":{"jog_modifier_cap":0.75}}).ok,"comfortable jog cap is bounded and configurable")
	check(is_equal_approx(steady(a),0.75),"configured jog ceiling reaches reducer")
	var hud := Hud.new()
	var constants: Dictionary = hud.get_script().get_script_constant_map()
	hud.free()
	var choices: Array = constants.get("SETTINGS_CHOICES",[])
	check(choices.has(["run","run"]),"HUD run-mode row uses new run binding and glyph")
	var overlay: Array = constants.get("OVERLAY_ACTIONS",[])
	check("run" in overlay and "walk" in overlay,"HUD overlay distinguishes run from old precision")
	check(constants.Glyphs.has("run") and constants.Glyphs.has("walk"),"HUD keeps distinct run and precision icons")
	a.free()
func _initialize() -> void:
	test_default_hold(); test_modes(); test_analog(); test_modal_and_restore()
	test_profiles_and_physical_keys(); test_remap_and_hud()
	print("CONTROLS RUN ",JSON.stringify({"checks":checks,"failures":failures}))
	quit(0 if failures.is_empty() else 1)
