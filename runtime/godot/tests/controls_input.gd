extends SceneTree
var failures := []
var checks := 0
func check(value: bool, label: String) -> void:
	checks += 1
	if not value: failures.append(label); printerr("FAIL ", label)
func _initialize() -> void:
	var a = load("res://input/actions.gd").new()
	# Generic ramp/saturation checks exercise explicit full-speed auto mode.
	# FEEL2's default hold/jog contract has its own controls_run suite.
	a.configure({"version":1,"options":{"run_mode":"auto"}})
	a.advance({"digital":["move_up"]})
	check(a.get_move().length() > 0 and a.get_move().length() < 0.1, "keyboard starts with small virtual stick")
	if not a.has_method("configure"):
		check(false, "profile/remap implementation missing")
		a.free(); quit(1); return
	for i in 13: a.advance({"digital":["move_up"]})
	check(is_equal_approx(a.get_move().length(), 1.0), "full stick by 14 ticks")
	a.advance({"digital":["move_up","move_right"]})
	check(is_equal_approx(a.get_move().length(), 1.0), "diagonal circular clamp")
	a.advance({"digital":["move_right"]})
	check(is_equal_approx(a.get_move().length(), 1.0), "diagonal release preserves ramp")
	a.advance({"digital":["move_left","move_right"]})
	check(a.get_move().x < 0, "latest opposite key wins")
	a.advance({"digital":["move_up","walk"]})
	check(a.get_move().length() <= 0.35001 and a.is_pressed("walk"), "precision cap")
	for i in 6: a.advance({})
	check(a.get_move() == Vector2.ZERO, "release ramp completes six ticks")
	a.advance({"analog":[0.17,0]})
	check(a.get_move() == Vector2.ZERO, "pad dead zone")
	a.advance({"analog":[0.95,0]})
	check(is_equal_approx(a.get_move().x, 1.0), "pad saturation without keyboard ramp")
	a.advance({"analog":[0.5,0]})
	check(a.get_move().x > 0.0 and a.get_move().x < 1.0, "true analog magnitude")
	a.advance({"digital":["primary"]})
	for i in 3: a.advance({})
	check(a.consume_buffer("primary", true), "buffer at three ticks")
	check(not a.consume_buffer("primary", true), "buffer fires once")
	a.advance({"digital":["primary"]})
	for i in 9: a.advance({})
	check(not a.consume_buffer("primary", true), "buffer expired at nine")
	var contact: int = a.tick
	for i in 4: a.advance({})
	a.advance({"digital":["primary"]})
	check(a.consume_buffer("primary", false, contact), "explicit recent contact coyote")
	for i in 9: a.advance({})
	a.advance({"digital":["primary"]})
	check(not a.consume_buffer("primary", false, contact), "old contact rejected")
	a.set_context("menu")
	a.advance({"digital":["move_up","dodge"]})
	check(a.get_move() == Vector2.ZERO and not a.is_pressed("dodge") and a.just_pressed("confirm"), "modal Space confirms, cannot dodge")
	a.set_context("gameplay")
	for i in 20: a.advance({"digital":["move_up"]})
	check(a.get_move() == Vector2.ZERO, "post-modal held movement blocked")
	a.advance({}); a.advance({"digital":["move_up"]})
	check(a.get_move().length() > 0.0, "fresh post-modal movement")
	a.set_source("bot")
	for i in 35: a.advance({"digital":["reset"]})
	check(not a.just_pressed("reset"), "retry not before hold threshold")
	a.advance({"digital":["reset"]})
	check(a.just_pressed("reset"), "retry at 36 ticks")
	a.advance({"digital":["reset"]})
	check(not a.just_pressed("reset"), "held retry once")
	var saved: Dictionary = a.snapshot()
	a.advance({"digital":["move_left"]})
	var result: Dictionary = a.snapshot()
	a.restore(saved); a.advance({"digital":["move_left"]})
	check(a.snapshot() == result, "input hidden state restore")
	for preset in ["left","right"]:
		check(a.configure({"version":1,"preset":preset}).ok, "valid " + preset + " preset")
	for bad in [[], {"version":2}, {"version":1,"preset":"unknown"}, {"version":1,"options":{"run_mode":"sprint"}}, {"version":1,"options":{"focus_mode":42}}, {"version":1,"bindings":{"primary":[{"key":0}]}}, {"version":1,"bindings":{"bogus":[{"key":69}]}}, {"version":1,"bindings":{"primary":[{"key":81}]}}, {"version":1,"bindings":{"primary":[]}}, {"version":1,"tuning":{"run_speed_mps":999}}]:
		check(not a.configure(bad).ok, "reject invalid remap " + str(bad))
		check(a.binding_glyph("primary") == "E", "invalid remap falls back atomically")
	check(a.configure({"version":1,"bindings":{"primary":[{"key":70}]},"options":{"focus_mode":"toggle","run_mode":"hold","reduced_motion":true}}).ok, "valid remap/options")
	check(a.binding_glyph("primary") == "F", "glyph follows remap")
	a.set_source("bot"); a.advance({"digital":["focus"]}); a.advance({})
	check(a.is_pressed("focus"), "toggle focus persists")
	a.advance({"digital":["focus"]})
	check(not a.is_pressed("focus"), "toggle focus second press clears")
	check(not a.is_pressed("walk") and not a.is_pressed("run"), "hold-run mode defaults unmodified jog")
	a.advance({"digital":["run"]})
	check(a.is_pressed("run") and not a.is_pressed("walk"), "new hold-run modifier runs")
	a.set_context("menu"); a.advance({}); a.set_context("gameplay")
	check(not a.is_pressed("focus"), "modal clears focus toggle")
	a.free()
	print("CONTROLS INPUT checks=%d failures=%d" % [checks, failures.size()])
	quit(0 if failures.is_empty() else 1)
