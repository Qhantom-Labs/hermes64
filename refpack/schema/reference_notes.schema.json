{
 "$id": "hermes64.reference_notes/1.0",
 "title": "Hermes64 reference notes (agent side of hermes64_pack_from_refs)",
 "description": "Filled by Hermes after LOOKING at each reference image. Every field that drives the draft is a controlled word or a number, so equal notes give an equal pack. Free-text fields (notes, *_notes, title) are for humans only and are never copied into pack.json/audio.json; only their hash is recorded. Never put names of source games, films, studios, brands or people in any field.",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "schema",
  "version",
  "setting",
  "time_of_day",
  "mood",
  "materials",
  "shape_language",
  "fog",
  "lighting",
  "references"
 ],
 "properties": {
