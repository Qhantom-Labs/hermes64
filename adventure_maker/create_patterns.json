   {"id": "near_light", "light": {"at": "near", "ahead_m": 6.0, "lift_m": 1.5, "intensity": 1.2, "radius": 6.0, "color": "#fff2d8"}},
   {"id": "key_light", "light": {"at": "look_at", "lift_m": 1.2, "intensity": 1.2, "radius": 6.0, "color": "#fff2d8"}}
