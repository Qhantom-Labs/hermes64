 "camera_knobs": {
  "note": "Bounded camera/light candidates the capture stage may try when a room fails the style gate on a framing or value reason (never a threshold change). Candidate 0 is always the pattern camera. Deltas are relative to it; a pattern may list its own camera_alternates inside these bounds.",
  "max_candidates": 7, "fov": [52, 66], "height_delta_m": 1.0, "look_y_delta_m": 1.0, "move_delta_m": 3.0,
  "light": {"intensity_max": 1.2, "radius_max": 6.0, "max_lights": 1},
  "default_alternates": [
   {"id": "look_up_wide", "look_at_delta": [0, 0.8, 0], "fov": 66},
   {"id": "pull_back_raise", "move_back_m": 2.5, "position_delta": [0, 0.8, 0], "look_at_delta": [0, 0.4, 0]},
   {"id": "pull_back_look_up_wide", "move_back_m": 2.5, "position_delta": [0, 0.8, 0], "look_at_delta": [0, 1.0, 0], "fov": 66},
   {"id": "near_light_soft", "light": {"at": "near", "ahead_m": 6.0, "lift_m": 1.5, "intensity": 0.6, "radius": 5.0, "color": "#fff2d8"}},
   {"id": "near_light", "light": {"at": "near", "ahead_m": 6.0, "lift_m": 1.5, "intensity": 1.2, "radius": 6.0, "color": "#fff2d8"}},
   {"id": "key_light", "light": {"at": "look_at", "lift_m": 1.2, "intensity": 1.2, "radius": 6.0, "color": "#fff2d8"}}
  ],
  "never_retry": ["floating pieces", "doors without a wall opening"]
