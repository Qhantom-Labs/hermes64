    "geometry": {
      "type": "object",
      "properties": {
        "shape_vocabulary": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true
        },
        "bevel_m": {
          "$ref": "#/$defs/range"
        },
        "round_segments": {
          "$ref": "#/$defs/range"
        },
        "shading": {
          "enum": [
            "flat",
            "smooth_grouped"
          ]
        },
        "triangle_caps": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/id"
          },
          "additionalProperties": {
            "type": "integer",
            "minimum": 1,
            "maximum": 6000
          },
          "minProperties": 1,
          "maxProperties": 20
        },
        "proportions": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/id"
          },
          "additionalProperties": {
            "$ref": "#/$defs/range"
          },
          "minProperties": 1,
          "maxProperties": 16
        },
        "silhouette_checks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "minItems": 1,
          "maxItems": 16,
