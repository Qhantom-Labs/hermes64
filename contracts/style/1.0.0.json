            "type": "array",
            "items": {
              "$ref": "#/$defs/id"
            },
            "minItems": 1,
            "maxItems": 8,
            "uniqueItems": true
          },
          "minProperties": 0,
          "maxProperties": 64
        }
      },
      "required": [
        "selected",
        "required_slots",
