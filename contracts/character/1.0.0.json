{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "urn:hermes64:character-recipe:1.0.0",
 "title": "Character recipe",
 "description": "A character as typed choices: body + rig, build proportions, palette ROLES (never colours), parts from characters/library/parts.json, face, held prop, clips. Compiled by adventure_maker.character_recipe against a character style lock (contracts/character/style-1.0.0): out-of-lock values are clamped with a one-line reason, out-of-generator values, unknown parts and wrong roles are refused. Same recipe + seed + lock = byte-identical GLB. Imported legacy cast rows use `legacy` instead of the typed fields.",
 "type": "object",
 "required": ["schema_version", "id", "rig", "archetype", "body", "role", "name"],
 "additionalProperties": false,
 "properties": {
  "schema_version": {"const": "1.0.0"},
  "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,47}$"},
  "rig": {"type": "object", "additionalProperties": false, "required": ["id", "version"],
          "properties": {"id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,31}$"}, "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}}},
  "archetype": {"enum": ["person", "robot", "creature"]},
  "body": {"$ref": "#/$defs/part"},
  "role": {"enum": ["npc", "crowd", "companion", "enemy", "boss", "cameo"]},
  "name": {"type": "object", "additionalProperties": false, "required": ["display", "placeholder"],
           "properties": {"display": {"type": "string", "minLength": 1, "maxLength": 48}, "placeholder": {"type": "boolean"}}},
  "build": {"type": "object", "additionalProperties": false,
            "properties": {"height": {"type": "number", "minimum": 0.3, "maximum": 4},
                           "age": {"enum": ["child", "teen", "adult", "elder"]},
                           "head": {"type": "number", "minimum": 0.5, "maximum": 2},
                           "shoulders": {"type": "number", "minimum": 0.5, "maximum": 2},
                           "waist": {"type": "number", "minimum": 0, "maximum": 2},
                           "legs": {"type": "number", "minimum": 0.5, "maximum": 2}}},
  "skin": {"$ref": "#/$defs/role"},
  "hair": {"type": "object", "additionalProperties": false,
           "properties": {"style": {"$ref": "#/$defs/part"}, "color": {"$ref": "#/$defs/role"}}},
  "outfit": {"type": "array", "items": {"$ref": "#/$defs/part"}, "maxItems": 24, "uniqueItems": true},
  "colors": {"type": "object", "maxProperties": 16, "propertyNames": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,15}$"},
             "additionalProperties": {"$ref": "#/$defs/role"}},
  "face": {"type": "object", "additionalProperties": false,
           "properties": {"preset": {"$ref": "#/$defs/part"}, "expression": {"enum": ["neutral", "blink", "talk_a", "talk_b", "smile", "worried", "surprised", "sleepy"]},
                          "eyes": {"$ref": "#/$defs/role"}, "beard": {"$ref": "#/$defs/part"}, "visor": {"$ref": "#/$defs/part"}}},
  "prop": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/part"}]},
  "stance": {"oneOf": [{"type": "null"}, {"type": "string", "pattern": "^[a-z][a-z_]{0,23}$"}]},
  "clips": {"enum": ["human_base", "human_combat", "robot", "robot_boss", "enemy", "animal"]},
  "seed": {"type": "integer", "minimum": 0, "maximum": 2147483647},
  "tune": {"type": "object", "maxProperties": 24, "propertyNames": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,23}$"},
           "additionalProperties": {"oneOf": [{"type": "number"}, {"type": "boolean"}, {"type": "string", "pattern": "^[a-z][a-z_]{0,15}$"}]}},
  "boss": {"type": "object", "additionalProperties": false,
           "properties": {"scale": {"type": "number", "minimum": 0.5, "maximum": 2}, "crown": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/part"}]},
                          "emblem": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/part"}]}}},
  "legacy": {"type": "object", "additionalProperties": false, "required": ["pack", "kind", "params", "stance", "props"],
             "properties": {"pack": {"enum": ["polar_pod", "forest_village"]}, "kind": {"enum": ["person", "masked"]},
                            "params": {"type": "object", "maxProperties": 96}, "stance": {"type": "string", "pattern": "^[a-z][a-z_]{0,23}$"},
                            "props": {"type": "array", "items": {"type": "string", "pattern": "^[a-z]{1,16}$"}, "maxItems": 2},
                            "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
  "notes": {"type": "string", "maxLength": 400}
 },
 "$defs": {
  "part": {"type": "string", "pattern": "^[a-z]+\\.[a-z0-9_]{1,40}$"},
  "role": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,23}$"}
 }
}
