{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "puzzle": {
      "maxLength": 48,
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9_]{0,47}$",
      "type": "string"
    },
    "status": {
      "enum": [
        "solved"
      ]
    }
  },
  "required": [
    "puzzle",
    "status"
  ],
  "type": "object"
}
