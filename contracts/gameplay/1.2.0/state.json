    "failed": {
      "oneOf": [
        {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "type": "string"
        },
        {
          "const": ""
        }
      ]
    }
  },
  "required": [
    "abilities",
    "completed",
    "active",
    "failed",
    "checkpoint",
    "discovered"
  ],
  "type": "object"
}
