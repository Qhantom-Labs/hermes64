{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "config": {
      "additionalProperties": false,
      "properties": {
        "fast_travel": {
          "const": false
        },
        "load_policy": {
          "const": "one_region"
        }
      },
      "required": [
        "load_policy",
        "fast_travel"
      ],
      "type": "object"
    },
    "entities": {
      "additionalProperties": false,
      "properties": {
        "links": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "a": {
                "additionalProperties": false,
                "properties": {
                  "door": {
                    "maxLength": 64,
                    "minLength": 1,
                    "pattern": "^[a-z][a-z0-9_]{0,63}$",
                    "type": "string"
                  },
                  "region": {
                    "maxLength": 64,
                    "minLength": 1,
                    "pattern": "^[a-z][a-z0-9_]{0,63}$",
                    "type": "string"
                  }
                },
                "required": [
                  "region",
                  "door"
                ],
                "type": "object"
              },
              "b": {
                "additionalProperties": false,
                "properties": {
                  "door": {
                    "maxLength": 64,
                    "minLength": 1,
                    "pattern": "^[a-z][a-z0-9_]{0,63}$",
                    "type": "string"
                  },
                  "region": {
                    "maxLength": 64,
                    "minLength": 1,
                    "pattern": "^[a-z][a-z0-9_]{0,63}$",
                    "type": "string"
                  }
                },
                "required": [
                  "region",
                  "door"
                ],
                "type": "object"
              },
              "id": {
                "maxLength": 64,
                "minLength": 1,
                "pattern": "^[a-z][a-z0-9_]{0,63}$",
                "type": "string"
              }
            },
            "required": [
              "id",
              "a",
              "b"
            ],
            "type": "object"
          },
          "maxItems": 64,
          "minItems": 0,
          "type": "array"
        },
        "regions": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "checkpoint": {
                "maxLength": 64,
                "minLength": 1,
                "pattern": "^[a-z][a-z0-9_]{0,63}$",
                "type": "string"
              },
              "id": {
                "maxLength": 64,
                "minLength": 1,
                "pattern": "^[a-z][a-z0-9_]{0,63}$",
                "type": "string"
              },
              "landmarks": {
                "items": {
                  "additionalProperties": false,
                  "properties": {
                    "id": {
                      "maxLength": 64,
                      "minLength": 1,
                      "pattern": "^[a-z][a-z0-9_]{0,63}$",
                      "type": "string"
                    },
                    "name": {
                      "maxLength": 256,
                      "minLength": 1,
                      "type": "string"
                    },
                    "position_m": {
                      "items": {
                        "maximum": 1024,
                        "minimum": -1024,
                        "type": "number"
                      },
                      "maxItems": 3,
                      "minItems": 3,
                      "type": "array"
                    }
                  },
                  "required": [
                    "id",
                    "name",
                    "position_m"
                  ],
                  "type": "object"
                },
                "maxItems": 16,
                "minItems": 1,
                "type": "array"
              },
              "room": {
                "maxLength": 64,
                "minLength": 1,
                "pattern": "^[a-z][a-z0-9_]{0,63}$",
                "type": "string"
              }
            },
            "required": [
              "id",
              "room",
              "checkpoint",
              "landmarks"
            ],
            "type": "object"
          },
          "maxItems": 32,
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "regions",
        "links"
      ],
      "type": "object"
    },
    "id": {
      "const": "regions"
    },
    "version": {
      "const": "1.0.0"
    }
  },
  "required": [
    "id",
    "version",
    "config",
    "entities"
  ],
  "type": "object"
}
