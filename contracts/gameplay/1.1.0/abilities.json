{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "config": {
      "additionalProperties": false,
      "properties": {
        "max_health": {
          "maximum": 64,
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "max_health"
      ],
      "type": "object"
    },
    "entities": {
      "additionalProperties": false,
      "properties": {
        "abilities": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "id": {
                "maxLength": 64,
                "minLength": 1,
                "pattern": "^[a-z][a-z0-9_]{0,63}$",
                "type": "string"
              },
              "name": {
                "maxLength": 256,
                "minLength": 1,
                "type": "string"
              },
              "requires": {
                "items": {
                  "maxLength": 64,
                  "minLength": 1,
                  "pattern": "^[a-z][a-z0-9_]{0,63}$",
                  "type": "string"
                },
                "maxItems": 32,
                "minItems": 0,
                "type": "array",
                "uniqueItems": true
              }
            },
            "required": [
              "id",
              "name",
              "requires"
            ],
            "type": "object"
          },
          "maxItems": 32,
          "minItems": 0,
          "type": "array"
        }
      },
      "required": [
        "abilities"
      ],
      "type": "object"
    },
    "id": {
      "const": "abilities"
    },
    "version": {
      "const": "1.1.0"
    }
  },
  "required": [
    "id",
    "version",
    "config",
    "entities"
  ],
  "type": "object"
}
