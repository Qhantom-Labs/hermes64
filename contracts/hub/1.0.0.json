{
  "$id": "hermes64-hub/1.0.0",
  "title": "Hermes64 Hub registry index (hub/1.0.0)",
  "description": "One index.json per registry. Every entry points at a deterministic data-only archive (contract hermes64-hub-pack/1) whose own HUB.json must match the entry exactly. The plugin's copy of this schema and its licence allow-list are the authority; a registry cannot widen them.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "registry", "licences", "entries", "entries_sha256"],
  "properties": {
    "schema": {"const": "hub/1.0.0"},
    "registry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "contract", "plugin_version"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 80},
        "contract": {"const": "hermes64-hub-pack/1"},
        "plugin_version": {"$ref": "#/$defs/semver"},
        "base_url": {"type": "string", "maxLength": 300},
        "note": {"type": "string", "maxLength": 600}
      }
    },
    "licences": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed", "recommended"],
      "properties": {
        "allowed": {"type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": {"$ref": "#/$defs/licence"}},
        "recommended": {
          "type": "object",
          "additionalProperties": false,
          "required": ["assets", "data"],
          "properties": {"assets": {"$ref": "#/$defs/licence"}, "data": {"$ref": "#/$defs/licence"}}
        }
      }
    },
    "entries": {"type": "array", "maxItems": 10000, "items": {"$ref": "#/$defs/entry"}},
    "entries_sha256": {"$ref": "#/$defs/sha256"},
    "pending": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "kind", "note"],
        "properties": {
          "id": {"type": "string", "maxLength": 64},
          "name": {"type": "string", "maxLength": 60},
          "kind": {"$ref": "#/$defs/kind"},
          "note": {"type": "string", "maxLength": 400}
        }
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "semver": {"type": "string", "pattern": "^(0|[1-9][0-9]{0,3})\\.(0|[1-9][0-9]{0,3})\\.(0|[1-9][0-9]{0,3})$"},
    "kind": {"enum": ["style", "kit", "character", "sound", "cover", "game"]},
    "licence": {"enum": ["CC0-1.0", "CC-BY-4.0", "CC-BY-SA-4.0", "MIT", "Apache-2.0", "BSD-2-Clause", "BSD-3-Clause", "ISC"]},
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "bytes"],
      "properties": {
        "path": {"type": "string", "minLength": 1, "maxLength": 160},
        "sha256": {"$ref": "#/$defs/sha256"},
        "bytes": {"type": "integer", "minimum": 0, "maximum": 16777216},
        "tris": {"type": "integer", "minimum": 0, "maximum": 100000}
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "version", "kind", "author", "licence", "summary", "tags", "size", "sha256", "files",
                   "compat", "tier", "download", "created_by", "source", "visibility"],
      "properties": {
        "id": {"type": "string", "maxLength": 64, "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+){1,3}$"},
        "name": {"type": "string", "minLength": 1, "maxLength": 60},
        "version": {"$ref": "#/$defs/semver"},
        "kind": {"$ref": "#/$defs/kind"},
        "author": {"type": "string", "minLength": 1, "maxLength": 80, "pattern": "^[^@<>\\n]+$"},
        "licence": {"$ref": "#/$defs/licence"},
        "summary": {"type": "string", "minLength": 1, "maxLength": 160},
        "tags": {"type": "array", "maxItems": 16, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,31}$"}},
        "size": {"type": "integer", "minimum": 1, "maximum": 67108864},
        "sha256": {"$ref": "#/$defs/sha256"},
        "files": {"type": "array", "minItems": 1, "maxItems": 511, "items": {"$ref": "#/$defs/file"}},
        "preview": {"type": "string", "maxLength": 120, "pattern": "^previews/[a-z0-9_.-]+\\.png$"},
        "preview_source": {"type": "string", "maxLength": 200},
        "palette": {"type": "array", "maxItems": 32, "items": {"type": "string", "pattern": "^#[0-9A-F]{6}$"}},
        "compat": {
          "type": "object",
          "additionalProperties": false,
          "required": ["contract", "plugin", "style"],
          "properties": {
            "contract": {"type": "string", "maxLength": 40},
            "plugin": {"type": "string", "pattern": "^>=(0|[1-9][0-9]{0,3})\\.(0|[1-9][0-9]{0,3})\\.(0|[1-9][0-9]{0,3})$"},
            "style": {"type": "string", "pattern": "^(any|[a-z][a-z0-9_]{0,63})$"},
            "profile": {"type": "string", "maxLength": 80},
            "story": {"type": "string", "maxLength": 16},
            "rig": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,47}@(0|[1-9][0-9]{0,3})\\.(0|[1-9][0-9]{0,3})\\.(0|[1-9][0-9]{0,3})$",
                    "description": "Character entries: the rig kit contract the model validates against (rigs/<id>/rig.json, e.g. human16_v1@1.0.0); installs are refused when this Hermes64 lacks that rig."}
          }
        },
        "tier": {
          "type": "object",
          "additionalProperties": false,
          "required": ["label", "proof", "playtest", "style", "human"],
          "properties": {
            "label": {"enum": ["playtested", "proved", "owner-approved", "validated", "machine-checked", "data-checked", "data-only", "draft"]},
            "proof": {"type": "string", "minLength": 1, "maxLength": 80},
            "playtest": {"type": "string", "minLength": 1, "maxLength": 80},
            "style": {"type": "string", "minLength": 1, "maxLength": 80},
            "human": {"type": "string", "minLength": 1, "maxLength": 80}
          }
        },
        "download": {"type": "string", "minLength": 1, "maxLength": 300},
        "created_by": {"type": "string", "pattern": "^hermes64 (0|[1-9][0-9]{0,3})\\.(0|[1-9][0-9]{0,3})\\.(0|[1-9][0-9]{0,3})$"},
        "source": {"enum": ["bundled", "community"]},
        "visibility": {"enum": ["public", "public-with-notice"]},
        "notice": {"type": "string", "maxLength": 400},
        "budget": {
          "type": "object",
          "additionalProperties": false,
          "properties": {"tris_max": {"type": "integer", "minimum": 0}, "bytes": {"type": "integer", "minimum": 0}}
        },
        "catalog_ids": {"type": "array", "maxItems": 600, "items": {"type": "string", "maxLength": 120}}
      }
    }
  }
}
