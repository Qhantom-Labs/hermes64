{
  "$id": "hermes64-catalog/1.0.0",
  "title": "Hermes64 asset catalog (hermes64-catalog/1.0.0)",
  "description": "Generated by tools/catalog.py from the repository manifests (never hand-written); the same shape is used for a game project's catalog.json of installed hub assets. Display names come from catalog/names.json.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "generated_by", "note", "counts", "assets"],
  "properties": {
    "schema": {"const": "hermes64-catalog/1.0.0"},
    "generated_by": {"type": "string", "minLength": 1, "maxLength": 120},
    "note": {"type": "string", "maxLength": 600},
    "sources": {"type": "object", "additionalProperties": {"$ref": "#/$defs/sha256"}},
    "counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "assets": {"type": "array", "maxItems": 5000, "items": {"$ref": "#/$defs/asset"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "bytes"],
      "properties": {
        "path": {"type": "string", "minLength": 1, "maxLength": 200},
        "sha256": {"$ref": "#/$defs/sha256"},
        "bytes": {"type": "integer", "minimum": 0},
        "tris": {"type": "integer", "minimum": 0},
        "variant": {"type": "string", "maxLength": 80}
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "kind", "source_lane", "files", "hashes", "budgets", "tags", "licence", "provenance",
                   "preview", "visibility", "used_by"],
      "properties": {
        "id": {"type": "string", "maxLength": 120, "pattern": "^[a-z]+:[a-z0-9_./-]+$"},
        "name": {"type": "string", "minLength": 1, "maxLength": 80},
        "placeholder": {"type": "boolean"},
        "kind": {"enum": ["person", "creature", "item", "kit", "sound", "cover", "style", "pack", "game"]},
        "source_lane": {"type": "string", "minLength": 1, "maxLength": 60},
        "source": {"type": "string", "maxLength": 200},
        "files": {"type": "array", "maxItems": 600, "items": {"$ref": "#/$defs/file"}},
        "hashes": {"type": "object", "maxProperties": 8, "additionalProperties": {"$ref": "#/$defs/sha256"}},
        "budgets": {"type": "object", "maxProperties": 12, "additionalProperties": {"type": "integer", "minimum": 0}},
        "tags": {"type": "array", "maxItems": 24, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]{0,39}$"}},
        "licence": {"type": "string", "pattern": "^[A-Za-z0-9.+-]{2,40}$"},
        "provenance": {"type": "string", "minLength": 1, "maxLength": 300},
        "preview": {"oneOf": [{"type": "null"}, {"type": "string", "pattern": "^[a-z0-9_./-]+\\.png$", "maxLength": 200}]},
        "preview_source": {"type": "string", "maxLength": 200},
        "visibility": {"enum": ["public", "public-with-notice", "demo-only", "internal"]},
        "used_by": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"type": "string", "maxLength": 120}},
        "style": {"type": "string", "maxLength": 64},
        "hub": {"type": "string", "maxLength": 64},
        "status": {"enum": ["available", "render-on-demand", "pending-assembly", "installed"]},
        "notice": {"type": "string", "maxLength": 200},
        "installed": {
          "type": "object",
          "additionalProperties": false,
          "required": ["entry", "version", "sha256", "registry"],
          "properties": {
            "entry": {"type": "string", "maxLength": 64},
            "version": {"type": "string", "maxLength": 16},
            "sha256": {"$ref": "#/$defs/sha256"},
            "registry": {"type": "string", "maxLength": 300}
          }
        }
      }
    }
  }
}
