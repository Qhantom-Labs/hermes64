        "morning",
        "noon",
        "afternoon",
        "golden-hour",
        "dusk",
        "night"
      ]
    },
    "weather": {
      "enum": [
        "clear",
        "cloudy",
        "rain",
        "storm",
        "fog",
        "snow",
        "wind",
        "sandstorm",
        "ash",
        "underwater",
