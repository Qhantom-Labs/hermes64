    ],
    "logo": [
      "png",
      "jpg",
      "jpeg"
    ],
    "image": [
      "png",
      "jpg",
      "jpeg"
    ],
    "audio": [
      "wav",
      "ogg",
      "mp3",
      "flac"
    ]
  },
  "x-hue-family": {
    "red": "red",
    "crimson": "red",
    "orange": "orange",
    "amber": "orange",
    "gold": "yellow",
    "yellow": "yellow",
    "lime": "green",
    "green": "green",
    "emerald": "green",
    "teal": "cyan",
    "cyan": "cyan",
    "blue": "blue",
    "indigo": "blue",
    "purple": "purple",
    "violet": "purple",
    "magenta": "magenta",
    "pink": "magenta",
    "brown": "brown",
    "tan": "brown",
    "grey": "neutral",
    "silver": "neutral",
    "white": "neutral",
    "black": "neutral"
  }
}
